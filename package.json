{
  "name": "project-meterfall",
  "version": "0.1.0",
  "private": true,
  "description": "Browser rhythm RPG \u2014 single-player, pixel-art, audio-clock-driven combat.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art:ground": "python3 tools/overworld/paint_ground.py && python3 tools/overworld/check_plate.py",
    "art:check": "python3 tools/overworld/check_plate.py"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "phaser": "^3.80.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
